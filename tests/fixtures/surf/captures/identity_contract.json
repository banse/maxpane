 ],
 "source_code_head": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.24;\n\nimport {ERC721} from \"solady/tokens/ERC721.sol\";\nimport {Ownable} from \"solady/auth/Ownable.sol\";\nimport {IdentityRenderer} from \"./IdentityRenderer.sol\";\n\n/// @notice Free mint ERC721 for identity.md.\ncontract IdentityMD is ERC721, Ownable {\n    error TokenIdOutOfRange();\n    error AlreadyMinted();\n    error WalletAlreadyMinted();\n    error NotTokenOwner();\n    error EmptyIdentityHash();\n    error IdentityHashLocked();\n    error IdentityHashNotAllowed();\n\n    event IdentityAllowedUpdated(bool allowed);\n    event IdentityHashUpdated(uint256 indexed id, string ipfsHash, bool permanent);\n    event EpochUpdated(uint256 indexed epoch);\n    event Univ4HookUpdated(address indexed hook);\n    event Univ4PoolUpdated(address indexed pool);\n\n    uint256 public constant MAX_SUPPLY = 2000;\n\n    IdentityRenderer public immutable renderer;\n    uint256 public totalSupply;\n    uint256 public epoch;\n    bool public identityAllowed;\n    address public univ4Hook;\n    address public univ4Pool;\n\n    mapping(address minter => bool minted) public hasMinted;\n    mapping(uint256 id => bool set) public hasIdentityHash;\n    mapping(uint256 id => bool locked) public identityHashLocked;\n\n    mapping(uint256 id => string ipfsHash) private _identityHashes;\n\n    constructor(IdentityRenderer renderer_) {\n        renderer = renderer_;\n        _initializeOwner(msg.sender);\n    }\n\n    function name() public pure override returns (string memory) {\n        return \"identity.md\";\n    }\n\n    function symbol() public pure override returns (string memory) {\n        return \"IDMD\";\n    }\n\n    /// @notice Free mint a specific token ID. IDs are 0 through 1999. One mint per wallet.\n    function mint(uint256 id) external {\n        if (id >= MAX_SUPPLY) revert TokenIdOutOfRange();\n        if (_exists(id)) revert AlreadyMinted();\n        if (hasMinted[msg.sender]) revert WalletAlreadyMinted();\n\n        hasMinted[msg.sender] = true;\n        unchecked {\n            ++totalSupply;\n        }\n        _mint(msg.sender, id);\n    }\n\n    function setIdentityAllowed(bool allowed) external onlyOwner {\n        identityAllowed = allowed;\n        emit IdentityAllowedUpdated(allowed);\n    }\n\n    function setEpoch(uint256 epoch_) external onlyOwner {\n        epoch = epoch_;\n        emit EpochUpdated(epoch_);\n    }\n\n    function setUniv4Hook(address hook) external onlyOwner {\n        univ4Hook = hook;\n        emit Univ4HookUpdated(hook);\n    }\n\n    function setUniv4Pool(address pool) external onlyOwner {\n        univ4Pool = pool;\n        emit Univ4PoolUpdated(pool);\n    }\n\n    /// @notice Set or update the token's identity markdown IPFS hash. Pass `permanent=true` to lock it forever.\n    function setIdentityHash(uint256 id, string calldata ipfsHash, bool permanent) external {\n        if (!identityAllowed) revert IdentityHashNotAllowed();\n        if (ownerOf(id) != msg.sender) revert NotTokenOwner();\n        if (identityHashLocked[id]) revert IdentityHashLocked();\n        if (bytes(ipfsHash).length == 0) revert EmptyIdentityHash();\n\n        _identityHashes[id] = ipfsHash;\n        hasIdentityHash[id] = true;\n        if (permanent) identityHashLocked[id] = true;\n\n        emit IdentityHashUpdated(id, ipfsHash, permanent);\n    }\n\n    function identityHash(uint256 id) external view returns (string memory) {\n        ownerOf(id);\n        return _identityHashes[id];\n    }\n\n    function tokenURI(uint256 id) public view override returns (string memory) {\n        ownerOf(id);\n        return renderer.tokenURI(id, _identityHashes[id], hasIdentityHash[id], identityHashLocked[id]);\n    }\n}\n"
}