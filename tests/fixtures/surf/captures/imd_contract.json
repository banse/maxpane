 ],
 "source_code_head": "// SPDX-License-Identifier: UNLICENSED\npragma solidity ^0.8.22;\n\nimport {Ownable} from \"@openzeppelin/contracts/access/Ownable.sol\";\nimport {OFT} from \"@layerzerolabs/oft-evm/contracts/OFT.sol\";\n\n/// @notice OFT is an ERC-20 token that extends the OFTCore contract.\ncontract BridgedFP is OFT {\n    // Private storage for token metadata that can be updated\n    string private _updatableName;\n    string private _updatableSymbol;\n    \n    // Events for metadata updates\n    event NameUpdated(string oldName, string newName);\n    event SymbolUpdated(string oldSymbol, string newSymbol);\n\n    constructor(string memory _name, string memory _symbol, address _lzEndpoint, address _delegate)\n        OFT(_name, _symbol, _lzEndpoint, _delegate)\n        Ownable(_delegate)\n    {\n        _updatableName = _name;\n        _updatableSymbol = _symbol;\n    }\n\n    /**\n     * @dev Returns the name of the token.\n     * @return The current name of the token\n     */\n    function name() public view override returns (string memory) {\n        return _updatableName;\n    }\n\n    /**\n     * @dev Returns the symbol of the token.\n     * @return The current symbol of the token\n     */\n    function symbol() public view override returns (string memory) {\n        return _updatableSymbol;\n    }\n\n    /**\n     * @dev Updates the name of the token. Only callable by the owner.\n     * @param newName The new name for the token\n     */\n    function updateName(string memory newName) external onlyOwner {\n        require(bytes(newName).length > 0, \"FPHyperLiquid: name cannot be empty\");\n        string memory oldName = _updatableName;\n        _updatableName = newName;\n        emit NameUpdated(oldName, newName);\n    }\n\n    /**\n     * @dev Updates the symbol of the token. Only callable by the owner.\n     * @param newSymbol The new symbol for the token\n     */\n    function updateSymbol(string memory newSymbol) external onlyOwner {\n        require(bytes(newSymbol).length > 0, \"FPHyperLiquid: symbol cannot be empty\");\n        string memory oldSymbol = _updatableSymbol;\n        _updatableSymbol = newSymbol;\n        emit SymbolUpdated(oldSymbol, newSymbol);\n    }\n\n    /**\n     * @dev Updates both name and symbol of the token in a single transaction. Only callable by the owner.\n     * @param newName The new name for the token\n     * @param newSymbol The new symbol for the token\n     */\n    function updateNameAndSymbol(string memory newName, string memory newSymbol) external onlyOwner {\n        require(bytes(newName).length > 0, \"FPHyperLiquid: name cannot be empty\");\n        require(bytes(newSymbol).length > 0, \"FPHyperLiquid: symbol cannot be empty\");\n        \n        string memory oldName = _updatableName;\n        string memory oldSymbol = _updatableSymbol;\n        \n        _updatableName = newName;\n        _updatableSymbol = newSymbol;\n        \n        emit NameUpdated(oldName, newName);\n        emit SymbolUpdated(oldSymbol, newSymbol);\n    }\n}\n"
}